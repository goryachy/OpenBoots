{
  "name": "openboots",
  "version": "1.0.0",
  "description": "Mobile-first inventory and lightweight wholesale sales",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"tsx src/server.js\" \"vite\"",
    "start": "node index.js",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src --ext .js,.ts,.tsx",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "better-sqlite3": "latest",
    "bwip-js": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "pdfkit": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tesseract.js": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  }
}
